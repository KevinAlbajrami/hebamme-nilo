# Frontend (Vite) env vars
#
# If your contact backend is on the same origin and you proxy /contact (e.g. via nginx),
# you can leave this empty and the frontend will POST to /contact.
#
# If your backend is on a different host/port, set the full base URL (no trailing slash).
# Example:
# VITE_BACKEND_URL=https://api.example.com
# VITE_BACKEND_URL=http://127.0.0.1:1337
VITE_BACKEND_URL=
